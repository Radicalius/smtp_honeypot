echo -e "EHLO test\r\nDATA\r\na\r\n.\r\nDATA\r\nb\r\n.\r\nQUIT\r\n" | nc localhost 2525

220 mail.example.com ESMTP
250-{server_name}
250-PIPELINING
250-SIZE 10240000
250-VRFY
250-ETRN
250-STARTTLS
250-AUTH LOGIN PLAIN
250 8BITMIME
354 3.0.0 Start mail input
250 2.0.0 OK
354 3.0.0 Start mail input
250 2.0.0 OK
221 2.0.0 Bye